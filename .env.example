# Identificadores de carpetas en Google Drive (extraídos de la URL en drive.google.com)
GDRIVE_PENDING_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j_ejemplo
GDRIVE_PUBLISHED_FOLDER_ID=9z8y7x6w5v4u3t2s1r0q_ejemplo

# Estado de subida de YouTube ('public', 'unlisted' o 'private')
YOUTUBE_PRIVACY_STATUS=public

# Categoría (22 = People & Blogs, 24 = Entertainment, etc.)
YOUTUBE_CATEGORY_ID=22

# Candado de protección en minutos
COOLDOWN_MINUTES=45

# Llamada a la acción (CTA) predeterminada para descripciones
DEFAULT_CTA=🔔 ¡Suscríbete para más contenido diario! Dale like y comenta si te gustó.
